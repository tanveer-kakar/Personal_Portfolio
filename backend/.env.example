# ── Local development (pgAdmin on your machine) ──────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portfolio_db
DB_USER=postgres
DB_PASSWORD=your_password_here
PORT=5000

# ── Production on Render / Supabase / Railway ─────────────────────────────────
# If your host gives you a single connection string, use this instead:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Your Netlify frontend URL (so CORS allows it)
# FRONTEND_URL=https://your-site.netlify.app
