# ── Backend API URL (your Render/Railway deployed backend) ───────────────────
# Once you deploy backend to Render, set this to your Render service URL
# Example: https://portfolio-backend-xxxx.onrender.com
VITE_BACKEND_URL=https://your-backend.onrender.com

# ── Web3Forms (email notifications) ──────────────────────────────────────────
# Get your free key from https://web3forms.com (enter tanveerkakar294@gmail.com)
VITE_WEB3FORMS_KEY=YOUR_ACCESS_KEY_HERE
