# ════════════════════════════════════════════════════════════════════════
#  NETLIFY ENVIRONMENT VARIABLES
#  Set these in: Netlify Dashboard → Site Settings → Environment Variables
# ════════════════════════════════════════════════════════════════════════

# ── PostgreSQL connection string (Supabase — free hosted Postgres) ────────────
#
#  HOW TO GET IT (5 minutes, free):
#  1. Go to https://supabase.com and sign up with GitHub
#  2. Click "New Project" → give it a name, set a password, choose a region
#  3. Wait ~1 minute for provisioning
#  4. Go to Project Settings → Database → Connection string → "URI" tab
#  5. Copy the URI (looks like: postgresql://postgres:[PASSWORD]@db.xxxx.supabase.co:5432/postgres)
#  6. Paste it below (replace [YOUR-PASSWORD] with your actual password)
#
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ── Web3Forms (optional — sends email notification on each submission) ─────────
#  1. Go to https://web3forms.com
#  2. Enter tanveerkakar294@gmail.com → click "Create Access Key"
#  3. Check your email and copy the key
#
VITE_WEB3FORMS_KEY=YOUR_WEB3FORMS_ACCESS_KEY
